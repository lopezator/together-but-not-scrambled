{
  "manifest_version": 3,
  "name": "Together, but not scrambled",
  "version": "1.0",
  "description": "Adds a button to randomly shuffle assignee columns in a GitHub Project board.",
  "icons": {
    "128": "../icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "together-but-not-scrambled@lopezator.dev",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/orgs/*/projects/*", "https://github.com/users/*/projects/*"],
      "js": ["content.js"]
    }
  ]
}
